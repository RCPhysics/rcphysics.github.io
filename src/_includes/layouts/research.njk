{# ===========================================================================
   layouts/research.njk
   ---------------------------------------------------------------------------
   Research strands page. Renders _data/strands.yml as service-rows (the
   design-system row with num · title · desc · tags gutter).
   ============================================================================ #}
{% extends "base.njk" %}

{% block content %}

{% include "partials/page-title.njk" %}

<section class="section no-rule">
  <div class="container">
    {% for s in strands.items %}
      <div class="service-row">
        <div class="num">{{ s.num }}</div>
        <div class="title">{{ s.title }}</div>
        <div class="desc">{{ s.desc }}</div>
        <div class="price">
          {% for t in s.tags %}{{ t }}{% if not loop.last %}<br>{% endif %}{% endfor %}
        </div>
      </div>
    {% endfor %}

    <div style="margin-top:48px; display:flex; gap:16px; flex-wrap:wrap;">
      <a class="btn btn-glass" href="/lamb/">See the lab ↗</a>
      <a class="btn btn-secondary" href="/publications/">Read the publications</a>
    </div>
  </div>
</section>

{% endblock %}
